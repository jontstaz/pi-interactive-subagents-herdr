{
  "name": "pi-interactive-subagents-herdr",
  "version": "1.0.1",
  "description": "Interactive subagents for pi - spawn, orchestrate, and manage sub-agent sessions in Herdr",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "author": "jontstaz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jontstaz/pi-interactive-subagents-herdr.git"
  },
